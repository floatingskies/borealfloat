# Run with --cap-add sys_admin --security-opt label=disable.
# Mirrors the universal blue (bazzite/aurora) installer Containerfile.
#
# BASE_IMAGE          : the image the live session boots from
# INSTALL_IMAGE_PAYLOAD: the image anaconda installs to disk
# Both default to the stable Borealis image.

ARG BASE_IMAGE=${BASE_IMAGE:-ghcr.io/floatingskies/borealis:stable}
ARG INSTALL_IMAGE_PAYLOAD=${INSTALL_IMAGE_PAYLOAD:-ghcr.io/floatingskies/borealis:stable}

FROM $BASE_IMAGE
ARG BASE_IMAGE
ARG INSTALL_IMAGE_PAYLOAD
RUN --mount=type=bind,source=./.,target=/src \
    env \
    BASE_IMAGE="$BASE_IMAGE" \
    INSTALL_IMAGE_PAYLOAD="$INSTALL_IMAGE_PAYLOAD" \
    /src/build.sh