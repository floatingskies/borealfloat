[Unit]
Description=Install Borealis default Flatpaks
Documentation=https://github.com/floatingskies/borealis#flatpaks
# Intentionally NOT ordered after network-online.target: first boot must never
# wait on the network. If the network isn't up yet the script fails and the
# Restart=on-failure below retries it in the background every 30s, so the
# desktop comes up immediately no matter what.

[Service]
Type=oneshot
ExecStart=/usr/libexec/borealis-flatpak-manager.sh
Restart=on-failure
RestartSec=30
StartLimitInterval=0

[Install]
WantedBy=multi-user.target